DATABASE_URL="postgresql://postgres:change-me@localhost:5432/auth_service"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="change-me"
POSTGRES_DB="auth_service"
PORT="3000"
SECRET_KEY="replace-with-a-long-random-secret"
REDIS_URL="redis://localhost:6379"

# Conta Azul Puppeteer adapter
CONTA_AZUL_LOGIN_URL="https://login.contaazul.com"
CONTA_AZUL_HEADLESS="true"
CONTA_AZUL_LOGIN_TIMEOUT_MS="30000"
CONTA_AZUL_AUTHENTICATED_URL_PATTERN="app.contaazul.com"
CONTA_AZUL_EMAIL_SELECTOR='input[type="email"]'
CONTA_AZUL_PASSWORD_SELECTOR='input[type="password"]'
CONTA_AZUL_SUBMIT_SELECTOR='button[type="submit"]'
CONTA_AZUL_TOTP_SELECTOR='input[type="text"]'
CONTA_AZUL_ERROR_SELECTOR="div.ds-box-information--danger"
CONTA_AZUL_TOTP_ERROR_SELECTOR=".ds-field__error-message--text"
CONTA_AZUL_ACCESS_TOKEN_COOKIE_NAME="x-ca-auth"
CONTA_AZUL_EXPIRES_AT_COOKIE_NAME="ca-access-token-expiry"
